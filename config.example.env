BOT_TOKEN=123456:ABC-your-bot-token
# numeric channel id, not @username - see README "Finding your channel ID"
GATE_CHANNEL=-1001234567890
GATE_CHANNEL_INVITE_LINK=https://t.me/your_channel_username

# optional, defaults shown
CACHE_DIR=/var/lib/igsave-bot/cache
CACHE_TTL_SECONDS=3600
# hard cap on cache disk usage; oldest entries evicted first once exceeded.
# default (10000 = 10GB) assumes a small VPS - see README "Sizing for a
# small VPS" if your disk is smaller than that.
CACHE_MAX_MB=10000
YT_DLP_PATH=yt-dlp
TELEGRAM_MAX_UPLOAD_MB=50
WORKER_COUNT=2
JOB_TIMEOUT_SECONDS=120
