BOT_TOKEN=123456:ABC-your-bot-token
# numeric channel id, not @username - see README "Finding your channel ID"
GATE_CHANNEL=-1001234567890
GATE_CHANNEL_INVITE_LINK=https://t.me/your_channel_username

# optional, defaults shown
CACHE_DIR=/var/lib/igsave-bot/cache
CACHE_TTL_SECONDS=3600
# hard cap on cache disk usage; oldest entries evicted first once exceeded.
# default (10000 = 10GB) assumes a small VPS - see README "Sizing for a
# small VPS" if your disk is smaller than that.
CACHE_MAX_MB=10000
YT_DLP_PATH=yt-dlp
TELEGRAM_MAX_UPLOAD_MB=50
WORKER_COUNT=2
JOB_TIMEOUT_SECONDS=120

# Local Bot API server (optional) - see README "Local Bot API server".
# Unset = public api.telegram.org, 50MB upload ceiling.
# Set = files are handed to the local server by path (nothing buffered in the
# bot's memory) and TELEGRAM_MAX_UPLOAD_MB can go up to 2000.
# TELEGRAM_BOT_API_URL=http://127.0.0.1:8081
# api_id/api_hash are a *user* app credential from my.telegram.org ->
# "API development tools". Not the bot token, and not interchangeable with it.
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=your32charhash
